<% layout("/layouts/boilerplate") %>


<div class="row mt-3">
    <h1 class="col-6 offset-3">SignUp on Wanderlust</h1>
    <div class="col-6 offset-3 ">
        <form action="/signup" method="POST" novalidate class="needs-validation">
            <div class="mb-3">
                <lable for="username" class="form-label">Username</lable>
                <input 
                type="text"
                 name="username" 
                 id="username"
                 class="form-control" 
                 required />
            <div class="valid-feedback">looks good!</div>   <!--here we are adding div inside title div and we are giving class = "valid-feedback" and then writes Tile looks good, so when we will fill the input boxes and give the title then this message will print below box -->
            </div> 
            <div class="mb-3">
                <lable for="email" class="form-label">Email</lable>
                <input 
                type="email"
                 name="email" 
                 id="email"
                 class="form-control" 
                 required />
           
            </div> 
            <div class="mb-3">
                <lable for="password" class="form-label">Password</lable>
                <input 
                type="password"
                 name="password" 
                 id="password"
                 class="form-control" 
                 required />
           
            </div> 
            <button class="btn btn-success">SignUp</button>

        </form>
    </div>
</div>