<% layout("/layouts/boilerplate") %>
<!-- required keyword in  all form tabs -->
    <div class="row mt-3">
        <div class="col-8 offset-2">
    <h3>Edit your listing</h3>
    <form method="post" action="/listings/<%= listing2._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">   <!--novalidate class="needs-validation" bootstrap as explained in new.ejs-->
   <!--3(b) 1st lec enctype added in form to collect image in place of url in edit form  -->
        <div class="mb-3">
            <lable for="title" class="form-label">Title</lable>
        <input type="text" name="listing[title]" value="<%=listing2.title%>" class="form-control" required>
        <div class="valid-feedback">Title looks good!</div>   <!--here we are adding div inside title div and we are giving class = "valid-feedback" and then writes Tile looks good, so when we will fill the input boxes and give the title then this message will print below box -->
    </div>
       
        <div class="mb-3">
            <lable for="description" class="form-label">Description</lable>
        <textarea name="listing[description]" class="form-control" required><%= listing2.description %></textarea>
        <div class="invalid-feedback">Please enter a short description</div> <!--bootrap div-->
        </div>

        <div class="mb-3">
            Original Listing Image <br>
          <img src="<%=originalImageUrl%>" alt="">
       </div>

        <div class="mb-3">
            <lable for="image" class="form-label">Upload New Image</lable>
        <input
         type="file" 
         name="listing[image]"
          
          class="form-control" 
          >
       </div>

       <div class="row">
        <div class="mb-3 col-md-4">
            <lable for="price" class="form-label">Price</lable>
        <input type="number" name="listing[price]" value="<%=listing2.price%>" class="form-control" required>
        <div class="invalid-feedback">Price should be Valid!</div> <!--bootstrap div it gives message in input box if input box is not filled-->
        </div>
        <div class="mb-3 col-md-4">
            <lable for="country" class="form-label">Country</lable>
        <input type="text" name="listing[country]" value="<%=listing2.country%>" class="form-control" required>
        <div class="invalid-feedback">Country name should be valid!</div>  <!--bootstrap div-->
       </div>
       </div>
       <div class="mb-3">
        <lable for="location" class="form-label">Location</lable>
        <input type="text" name="listing[location]" value="<%=listing2.location%>" class="form-control" required>
        <div class="invalid-feedback">Location should be valid!</div>    <!--bootstrap div-->
        
        </div>
    
        <button class="btn btn-dark edit-btn mt-3">Edit</button>
        <br>
        <br>
        
    </form>
       </div>
       </div>
       <script src="/js/script.js"></script>   <!--this script included for bootstrap logic in form-->
</body>
