<% layout("/layouts/boilerplate") %>

<style>
  .card-img-top{
    height: 400px;
  }
</style>

<script>  
  const mapToken = "<%=process.env.MAP_TOKEN %>";  //isko map.js ke liye yahaan se hmne mapToken ko access kiya h
  const listing = <%- JSON.stringify(listing2) %> ; //isko map.js ke liye yahaan se hmne coordinates ko access kiya h and Json.stringify isliye kiya h taaki ye string m convert ho jaaye and error na de
</script>



<div class="container mt-5">
  <div class="row">
    <div class="col-md-8 offset-md-2">
      <h3 class="text-center"><%= listing2.title %></h3>

      <div class="card mb-4">
        <img src="<%= listing2.image.url %>" class="card-img-top" alt="listing_image"  />
        <div class="card-body">
          <p class="card-text">Owned by: <i><%= listing2.owner.username %></i></p>
          <p class="card-text"><%= listing2.description %></p>
          <p class="card-text">&#8377;<%= listing2.price %>/night</p>
          <p class="card-text"><%= listing2.location %></p>
          <p class="card-text"><%= listing2.country %></p>
        </div>
      </div>

      <div class="d-flex justify-content-between mb-4">
        <a href="/listings/<%= listing2._id %>/edit" class="btn btn-primary">Edit</a>
        <form method="post" action="/listings/<%= listing2._id%>?_method=DELETE">
          <button class="btn btn-danger">Delete</button>
        </form>
      </div>

      <% if(currUser) { %>
      <hr>
      <h4>Leave a Review</h4>
      <form action="/listings/<%=listing2.id%>/reviews" method="POST" novalidate class="needs-validation">
        <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
          <fieldset class="starability-slot">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>
        <div class="mb-3">
          <label for="comment" class="form-label">Comments</label>
          <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
          <div class="invalid-feedback">Please add some comments for the review</div>
        </div>
        <button class="btn btn-outline-dark">Submit</button>
      </form>
      <% } %>

      <hr>
      <% if(listing2.reviews.length > 0) { %>
      <h4>All Reviews</h4>
      <div class="list-group mb-4">
        <% for(let review of listing2.reviews) { %>
        <div class="list-group-item">
          <h5 class="mb-1">@<%= review.author.username %></h5>
          <p class="starability-result mb-1" data-rating="<%= review.rating %>"></p>
          <p class="mb-1"><%= review.comment %></p>
          <form method="POST" action="/listings/<%= listing2._id %>/reviews/<%= review._id %>?_method=DELETE">
            <button class="btn btn-sm btn-danger">Delete</button>
          </form>
        </div>
        <% } %>
      </div>
      <% } %>

      <div class="mb-5">
        <h3>Where you'll be</h3>
        <div id="map" class="map-container"></div>
      </div>
    </div>
  </div>
</div>

<script src="/js/map.js"></script>
